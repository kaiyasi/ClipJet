# Backend listener. Use 0.0.0.0 only behind HTTPS/reverse proxy when public.
HOST=127.0.0.1
PORT=3000

# Frontend origins, separated by commas. Use * only if every browser origin is allowed.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# If a trusted reverse proxy is in front of Node, set this to its hop count.
# Keep 0 when exposing Node directly; do not trust client-supplied X-Forwarded-For.
TRUST_PROXY_HOPS=0

# Override these when the binaries are not available on PATH.
YTDLP_BIN=yt-dlp
FFMPEG_BIN=ffmpeg
ZIP_BIN=zip

# YouTube media compatibility. The EJS component is fetched by yt-dlp when
# needed; set YTDLP_REMOTE_COMPONENTS= to disable remote component loading.
YTDLP_JS_RUNTIME=node
YTDLP_REMOTE_COMPONENTS=ejs:github
YTDLP_EXTRACTOR_ARGS=youtube:player_client=web_embedded

# Files are ephemeral and removed after this idle period. No database is used.
EPHEMERAL_FILE_TTL_MS=300000
MAX_CONCURRENT_DOWNLOADS=2
MAX_PENDING_JOBS=20
MAX_ACTIVE_JOBS_PER_IP=2
MAX_CREATE_REQUESTS_PER_IP=8
RATE_LIMIT_WINDOW_MS=600000
IP_BLOCK_DURATION_MS=900000
DOWNLOAD_TIMEOUT_MS=1800000
MAX_JOB_BYTES=8589934592

# Optional. Defaults to the operating system temp directory.
# DOWNLOAD_DIR=/tmp/clipjet-downloads
